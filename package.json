{
  "name": "golf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "local": "npm run build && node --import tsx server/local.ts",
    "format": "prettier --write \"src/**/*.ts\" \"server/**/*.ts\" \"tests/**/*.ts\" \"tests/*.test.mjs\" src/core/style/cockpit.css playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"server/**/*.ts\" \"tests/**/*.ts\" \"tests/*.test.mjs\" src/core/style/cockpit.css playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  }
}
